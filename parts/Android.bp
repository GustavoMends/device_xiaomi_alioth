android_app {
    name: "XiaomiParts",

    srcs: ["src/**/*.java"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "org.lineageos.settings.xml",

    static_libs: [
        "org.lineageos.settings.resources",
    ],
}
